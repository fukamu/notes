{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "app/api/**/*.ts",
    "db/**/*.ts",
    "server/**/*.ts",
    "lib/codec/**/*.ts",
    "lib/domain/**/*.ts",
    "lib/shared/**/*.ts",
    "lib/sync/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
