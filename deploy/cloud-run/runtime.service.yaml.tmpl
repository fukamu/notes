apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: @@SERVICE_NAME@@
  namespace: "@@PROJECT_NUMBER@@"
  labels:
    cloud.googleapis.com/location: @@REGION@@
  annotations:
    run.googleapis.com/description: FUKAMU Notes restricted production
    run.googleapis.com/ingress: all
    run.googleapis.com/invoker-iam-disabled: "true"
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/minScale: "0"
        autoscaling.knative.dev/maxScale: "2"
        run.googleapis.com/cpu-throttling: "true"
        run.googleapis.com/execution-environment: gen2
        run.googleapis.com/startup-cpu-boost: "false"
    spec:
      containerConcurrency: 20
      timeoutSeconds: 60
      serviceAccountName: @@RUNTIME_SERVICE_ACCOUNT@@
      containers:
        - name: notes
          image: @@RUNTIME_IMAGE_DIGEST@@
          ports:
            - name: http1
              containerPort: 8080
          env:
            - name: NOTES_ENVIRONMENT
              value: production
            - name: NOTES_APPLICATION_PROFILE
              value: production
            - name: NOTES_PRIVATE_AUTH_MODE
              value: google-oidc
            - name: NOTES_HTTP_ADDR
              value: 0.0.0.0:8080
            - name: NOTES_DATABASE_MAX_CONNECTIONS
              value: "4"
            - name: NOTES_PUBLIC_ORIGIN
              value: @@PUBLIC_ORIGIN@@
            - name: NOTES_OIDC_CLIENT_ID
              value: @@OIDC_CLIENT_ID@@
            - name: NOTES_GCS_BUCKET
              value: @@GCS_BUCKET@@
            - name: NOTES_GCP_KMS_CRYPTO_KEY_VERSION
              value: @@KMS_KEY_VERSION@@
            - name: NOTES_DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: @@RUNTIME_DATABASE_SECRET_NAME@@
                  key: "@@RUNTIME_DATABASE_SECRET_VERSION@@"
            - name: NOTES_OIDC_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: @@OIDC_SECRET_NAME@@
                  key: "@@OIDC_SECRET_VERSION@@"
            - name: NOTES_PRODUCTION_CURSOR_HMAC_KEY
              valueFrom:
                secretKeyRef:
                  name: @@CURSOR_SECRET_NAME@@
                  key: "@@CURSOR_SECRET_VERSION@@"
          resources:
            limits:
              cpu: 1000m
              memory: 512Mi
          startupProbe:
            httpGet:
              path: /readyz
              port: 8080
            timeoutSeconds: 2
            failureThreshold: 15
            periodSeconds: 2
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 5
            timeoutSeconds: 2
            failureThreshold: 3
            periodSeconds: 10
