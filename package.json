{
  "name": "fukamu-notes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run build:service-worker && vinext build && node scripts/verify-service-worker.mjs && node scripts/verify-environment.mjs",
    "build:service-worker": "node scripts/build-service-worker.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "npm run lint:app && npm run lint:api && npm run lint:service-worker && npm run lint:tooling && npm run lint:test",
    "lint:app": "oxlint --tsconfig=tsconfig.json app/layout.tsx 'app/(notes)' components hooks lib",
    "lint:api": "oxlint --tsconfig=tsconfig.api.json app/api db",
    "lint:service-worker": "oxlint --tsconfig=tsconfig.service-worker.json service-worker",
    "lint:tooling": "oxlint --tsconfig=tsconfig.tooling.json drizzle.config.ts next.config.ts playwright.config.ts scripts vite.config.ts vitest.config.ts vitest.benchmark.config.ts",
    "lint:test": "oxlint --tsconfig=tsconfig.test.json tests",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "npm run typecheck:app && npm run typecheck:api && npm run typecheck:service-worker && npm run typecheck:tooling && npm run typecheck:test",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "typecheck:service-worker": "tsc -p tsconfig.service-worker.json --noEmit",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:architecture": "vitest run tests/unit/architecture.test.ts tests/unit/schema-drift.test.ts tests/unit/environment.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:server": "bash scripts/e2e-server.sh",
    "benchmark:connections": "vitest run --config vitest.benchmark.config.ts --disableConsoleIntercept",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "check:environment": "node scripts/verify-environment.mjs",
    "verify": "npm run format:check && npm run check && npm run test:e2e",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "elkjs": "^0.12.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "uuid": "^14.0.2",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "0.31.10",
    "fake-indexeddb": "^6.2.5",
    "miniflare": "4.20260515.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "^1.63.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^5.0.0",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
