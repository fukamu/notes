{
  "name": "fukamu-notes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.frontend.config.ts",
    "build": "npm run check:legal-commerce && npm run check:privacy-disclosure && npm run check:privacy-processing-registry && npm run check:legal-terms && npm run check:external-transmission && npm run check:card-payment-security && npm run check:launch-compliance && npm run build:frontend && node scripts/verify-service-worker.mjs && node --experimental-strip-types scripts/verify-environment.mts",
    "build:frontend": "npm run build:service-worker && vite build --config vite.frontend.config.ts && vite build --config vite.frontend.ssr.config.ts && node --experimental-strip-types scripts/prerender-public.mts",
    "build:service-worker": "node scripts/build-service-worker.mjs",
    "start": "go -C backend run ./cmd/notes",
    "lint": "npm run lint:app && npm run lint:api && npm run lint:service-worker && npm run lint:tooling && npm run lint:test",
    "lint:app": "oxlint --tsconfig=tsconfig.json app/layout.tsx 'app/(notes)' 'app/(public)' components hooks lib",
    "lint:api": "oxlint --tsconfig=tsconfig.api.json app/api db server",
    "lint:service-worker": "oxlint --tsconfig=tsconfig.service-worker.json service-worker",
    "lint:tooling": "oxlint --tsconfig=tsconfig.tooling.json drizzle.config.ts playwright.config.ts scripts vite.config.ts vite.frontend.config.ts vite.frontend.ssr.config.ts vitest.config.ts vitest.benchmark.config.ts vitest.client-benchmark.config.ts vitest.server-load.config.ts",
    "lint:test": "oxlint --tsconfig=tsconfig.test.json tests",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "npm run typecheck:app && npm run typecheck:api && npm run typecheck:service-worker && npm run typecheck:tooling && npm run typecheck:test",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "typecheck:service-worker": "tsc -p tsconfig.service-worker.json --noEmit",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:architecture": "vitest run tests/unit/architecture.test.ts tests/unit/schema-drift.test.ts tests/unit/environment.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:server": "bash scripts/e2e-server.sh",
    "benchmark:connections": "vitest run --config vitest.benchmark.config.ts --disableConsoleIntercept",
    "benchmark:client": "vitest run --config vitest.client-benchmark.config.ts --disableConsoleIntercept",
    "benchmark:client:presentation": "vitest run tests/benchmarks/client-demand-driven-presentation.benchmark.test.ts --config vitest.client-benchmark.config.ts --disableConsoleIntercept",
    "benchmark:client:link-index": "vitest run tests/benchmarks/client-link-candidate-index.benchmark.test.ts --config vitest.client-benchmark.config.ts --disableConsoleIntercept",
    "benchmark:client:history-index": "vitest run tests/benchmarks/client-history-preview-index.benchmark.test.ts --config vitest.client-benchmark.config.ts --disableConsoleIntercept",
    "benchmark:server-load": "vitest run --config vitest.server-load.config.ts --disableConsoleIntercept",
    "benchmark:migration": "node scripts/benchmark-migration.mjs",
    "contracts:check": "node scripts/check-contracts.mjs && vitest run tests/contracts",
    "go:format:check": "node --experimental-strip-types scripts/check-go-format.mts",
    "go:test:integration": "NOTES_TEST_DATABASE_URL=${NOTES_TEST_DATABASE_URL:-postgres://notes_test:notes_test_password@127.0.0.1:55432/fukamu_notes_go_test?sslmode=disable} go -C backend test -tags=integration ./tests/integration/...",
    "go:check": "npm run go:format:check && go -C backend vet ./... && go -C backend test ./... && npm run go:test:integration && go -C backend test -race ./... && go -C backend build ./cmd/...",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "check:environment": "node --experimental-strip-types scripts/verify-environment.mts",
    "check:legal-commerce": "node --experimental-strip-types scripts/verify-legal-commerce.mjs",
    "check:privacy-disclosure": "node --experimental-strip-types scripts/verify-privacy-disclosure.mjs",
    "check:privacy-processing-registry": "node --experimental-strip-types scripts/verify-privacy-processing-registry.mjs",
    "check:legal-terms": "node --experimental-strip-types scripts/verify-legal-terms.mjs",
    "check:external-transmission": "node --experimental-strip-types scripts/verify-external-transmission.mjs",
    "check:card-payment-security": "node --experimental-strip-types scripts/verify-card-payment-security.mjs",
    "check:launch-compliance": "node --experimental-strip-types scripts/verify-launch-compliance.mjs",
    "check:production-launch": "node --experimental-strip-types scripts/verify-launch-compliance.mjs --production-release",
    "verify": "npm run contracts:check && npm run format:check && npm run check && npm run go:check && FUKAMU_E2E_USE_PREBUILT=1 npm run test:e2e",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "elkjs": "^0.12.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "0.31.10",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "miniflare": "4.20260730.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "^1.63.0",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.1"
    }
  },
  "type": "module"
}
